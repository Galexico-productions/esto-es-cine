<html>

<head>
    <title>🍿 Movies</title>
    <%- include('./partials/head.ejs') %>
</head>

<body>
    <section>
        <h1>Movies!</h1>
        <div>
            <ol>
                <% for (const m of movies) { %>
                    <li>
                        <%= m.title %>
                            <form action="/movie/my-movies/<%= m._id %>?_method=DELETE" method="POST">
                                <button type="submit">Borrar Peli</button>
                            </form>
                    </li>
                    <% } %>
            </ol>
        </div>
    </section>

</body>

</html>