<html>

<head>
    <title>🍿 Movies</title>
    <%- include('./partials/head.ejs') %>
</head>

<body>
    <%- include('./partials/nav.ejs') %>
        <section class="p-8">
            <div>
                <ol class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-5">
                    <% for (const m of movies) { %>
                        <li class="flex flex-col items-center">
                            <div class="text-gray-700 mb-2 font-semibold text-lg text-center">
                                <%= m.title %>
                            </div>
                            <form action="/movie/my-movies/<%= m._id %>?_method=DELETE" method="POST">
                                <button
                                    class="px-2 py-0.5 rounded-lg font-semibold text-white bg-gradient-to-r from-orange-300 via-red-400 to-pink-700 hover:opacity-80 transition duration-300 shadow-md"
                                    type="submit">Delete movie</button>
                            </form>
                            <div
                                class="w-full aspect-w-2 aspect-h-3 rounded-lg overflow-hidden shadow-md bg-gray-800 flex items-center justify-center">
                                <% if (m.poster_path) { %>
                                    <img class="w-full h-full object-cover"
                                        src="https://image.tmdb.org/t/p/w500/<%= m.poster_path %>" alt="">
                                    <% } else { %>
                                        <img class="w-full h-full object-cover object-center"
                                            src="/img/no-movie-poster.jpg"
                                            alt="Placeholder for missing poster">
                                        <% } %>
                            </div>
                        </li>
                        <% } %>
                </ol>
            </div>
        </section>

</body>

</html>