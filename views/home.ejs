<head>
    <title>🍿 Movies</title>
    <%- include('./partials/head.ejs') %>
</head>

<body class="bg-gray-100">
    <%- include('./partials/nav.ejs') %>
        <section class="p-8">
            <!-- Add a title -->
            <div class="flex flex-col gap-8">
                <div class="flex flex-col gap-4 align-center justify-center items-center">
                    <button
                        class="px-6 py-1 rounded-lg font-semibold text-white bg-gradient-to-r from-orange-300 via-sky-400 to-teal-400 hover:opacity-80 transition duration-300 shadow-md">
                        <a href="/movie/my-movies">Check your catalogue</a>
                    </button>
                </div>
                <form class="flex flex-col gap-2 align-center justify-center items-center" action="/movie/new-movie"
                    method="POST">
                    <label for="title">Add a title to your catalogue</label>
                    <div class="flex flex-row gap-2 w-[50vw]">
                        <input
                            class="bg-gray-700 rounded-lg min-w-0 grow py-1 pr-3 pl-1 text-base text-white placeholder:text-gray-400 text-center focus:outline-none sm:text-sm/6"
                            type="text" name="title" id="title" placeholder="add a title">
                        <input
                            class="px-6 py-1 rounded-lg font-semibold text-white bg-gradient-to-r from-orange-300 via-sky-400 to-teal-400 hover:opacity-80 transition duration-300 shadow-md grow"
                            type="submit" value="Add Movie">
                    </div>
                </form>
                <!-- Search for a movie -->
                <form class="flex flex-col gap-2 align-center justify-center items-center " action="/movie/search"
                    method="GET">
                    <label for="title">Search for a movie</label>
                    <div class="flex flex-row gap-2 w-[50vw]">
                        <input
                            class="bg-gray-700 rounded-lg min-w-0 grow py-1 pr-3 pl-1 text-base text-white placeholder:text-gray-400 text-center focus:outline-none sm:text-sm/6"
                            type="text" name="title" id="title" placeholder="movie title">
                        <input
                            class="px-6 py-1 rounded-lg font-semibold text-white bg-gradient-to-r from-orange-300 via-sky-400 to-teal-400 hover:opacity-80 transition duration-300 shadow-md grow"
                            type="submit" value="Search" placeholder="movie title">
                    </div>
                </form>
                <!-- Movie list button -->

            </div>


        </section>


        <script>

            const button = document.getElementById(test)

            document.addEventListener('click', () => {
                console.log('test')
            })

        </script>
</body>

</html>