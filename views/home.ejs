<head>
    <title>🍿 Movies</title>
    <%- include('./partials/head.ejs') %>
</head>

<body>
    <%- include('./partials/nav.ejs') %>
        <section class="p-4">
            <!-- Add a title -->
            <div class="flex flex-col gap-8 mb-4">
                <form class="flex flex-col gap-4 align-center justify-center items-center mb-4"
                    action="/movie/new-movie" method="POST">
                    <label for="title">Add a title to your catalogue</label>
                    <input
                        class="bg-gray-700 rounded-lg block min-w-0 grow py-1 pr-3 pl-1 text-base text-white placeholder:text-gray-500 text-center focus:outline-none sm:text-sm/6"
                        type="text" name="title" id="title" placeholder="add a title">
                    <input
                        class="px-6 py-1 rounded-lg font-semibold text-white bg-gradient-to-r from-orange-300 via-sky-400 to-teal-400 hover:opacity-80 transition duration-300 shadow-md"
                        type="submit" value="Add Movie">
                </form>
                <!-- Search for a movie -->
                <form class="flex flex-col gap-4 align-center justify-center items-center mb-4" action="/movie/search"
                    method="GET">
                    <label for="title">Search for a movie</label>
                    <input
                        class="bg-gray-700 rounded-lg block min-w-0 grow py-1 pr-3 pl-1 text-base text-white placeholder:text-gray-500 text-center focus:outline-none sm:text-sm/6"
                        type="text" name="title" id="title" placeholder="movie title">
                    <input
                        class="px-6 py-1 rounded-lg font-semibold text-white bg-gradient-to-r from-orange-300 via-sky-400 to-teal-400 hover:opacity-80 transition duration-300 shadow-md"
                        type="submit" value="Search" placeholder="movie title">
                </form>
                <!-- Movie list button -->
                <div class="flex flex-col gap-4 align-center justify-center items-center mb-4">
                    <button
                        class="px-6 py-1 rounded-lg font-semibold text-white bg-gradient-to-r from-orange-300 via-sky-400 to-teal-400 hover:opacity-80 transition duration-300 shadow-md">
                        <a href="/movie/my-movies">Check your catalogue</a>
                    </button>
                </div>
            </div>


        </section>


        <script>

            const button = document.getElementById(test)

            document.addEventListener('click', () => {
                console.log('test')
            })

        </script>
</body>

</html>